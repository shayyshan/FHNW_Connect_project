# API Configuration
PROJECT_NAME="FHNW Connect API"
VERSION="0.1.0"
API_PREFIX="/api"
PORT=8001

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://user:password@server:port/database
# Render may also provide a postgres:// URL, which is normalized automatically.
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/fhnw_connect"

# CORS Setup (Generic)
# Comma-separated list of allowed origins (e.g., * for all, or specific domains)
CORS_ORIGINS="*"

# Basic auth credentials for protected endpoints (legacy support)
BASIC_AUTH_USER="myuser"
BASIC_AUTH_PASSWORD="password"
BASIC_AUTH_ADMIN="myadmin"
BASIC_AUTH_ADMIN_PASSWORD="password"

# Security (JWT Bearer Token Authentication)
# For production, generate a secure random key using: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-key-for-jwt-signing"

# Database Safety Control
# Set to True to drop and recreate database schema on startup. WARNING: Destructive!
RECREATE_DB=False

