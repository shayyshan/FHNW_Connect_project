# API Configuration
PROJECT_NAME="FHNW Connect API"
VERSION="0.1.0"
API_PREFIX="/api"
PORT=8001

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/database
# Render provides URLs that are automatically normalized to use psycopg driver.
DATABASE_URL="postgresql://user:password@dpg-xxxxx-a.region-postgres.render.com/database_name"

# CORS Setup (Generic)
# Comma-separated list of allowed origins (e.g., * for all, or specific domains)
CORS_ORIGINS="*"

# Basic auth credentials for protected endpoints
BASIC_AUTH_USER="myuser"
BASIC_AUTH_PASSWORD="password"
BASIC_AUTH_ADMIN="myadmin"
BASIC_AUTH_ADMIN_PASSWORD="password"
